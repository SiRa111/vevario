  function updateCodingGutter() {
    if (!codingEditorTextarea || !codingEditorGutter) return;
    const lines = codingEditorTextarea.value.split('\n').length;
    
    // Calculate cursor line number
    const textBeforeCursor = codingEditorTextarea.value.substring(0, codingEditorTextarea.selectionStart);
    const activeLine = textBeforeCursor.split('\n').length;

    let gutterHTML = '';
    for (let i = 1; i <= Math.max(lines, 1); i++) {
      let lineHTML = `<div class="relative w-full pr-1.5 h-[20px] flex items-center justify-end leading-[20px]">`;
      if (i === activeErrorLine) {
        lineHTML += `<span class="absolute left-1.5 top-[6px] w-2.5 h-2.5 rounded-full bg-red-500 border border-red-950 flex items-center justify-center font-bold text-[7px] text-white animate-pulse">!</span>`;
        lineHTML += `<span class="text-red-500 font-semibold">${i}</span>`;
      } else if (i === activeLine) {
        lineHTML += `<span class="text-ink font-bold transition-colors duration-150">${i}</span>`;
      } else {
        lineHTML += `<span class="text-mute/30 transition-colors duration-150">${i}</span>`;
      }
      lineHTML += `</div>`;
      gutterHTML += lineHTML;
    }
    codingEditorGutter.innerHTML = gutterHTML;
  }

  if (codingEditorTextarea) {
    // Scroll synchronization
    codingEditorTextarea.addEventListener('scroll', () => {
      codingEditorGutter.scrollTop = codingEditorTextarea.scrollTop;
    });

    // Cursor line update triggers
    codingEditorTextarea.addEventListener('input', () => {
      activeErrorLine = null; // Clear active error line when user edits the code
      updateCodingGutter();
    });
    codingEditorTextarea.addEventListener('keyup', updateCodingGutter);
    codingEditorTextarea.addEventListener('click', updateCodingGutter);
    codingEditorTextarea.addEventListener('focus', updateCodingGutter);
    
    codingEditorTextarea.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        const start = codingEditorTextarea.selectionStart;
        const end = codingEditorTextarea.selectionEnd;
        const currentVal = codingEditorTextarea.value;
        codingEditorTextarea.value = currentVal.substring(0, start) + "    " + currentVal.substring(end);
        codingEditorTextarea.selectionStart = codingEditorTextarea.selectionEnd = start + 4;
        updateCodingGutter();
      }
    });
  }

  // --- CODING WORKSPACE LOGICS & INTERACTIVE CONTROLLERS ---
  const btnRunCode = document.getElementById('btn-run-code');
  const lcConsoleOutput = document.getElementById('lc-console-output');
  const editorCursorPos = document.getElementById('editor-cursor-pos');
  const editorSavedStatus = document.getElementById('editor-saved-status');
  const tabLcTestcase = document.getElementById('tab-lc-testcase');
  const tabLcResult = document.getElementById('tab-lc-result');

  function updateCursorPos() {
    if (!codingEditorTextarea || !editorCursorPos) return;
    const text = codingEditorTextarea.value;
    const selStart = codingEditorTextarea.selectionStart;
    const linesBefore = text.substring(0, selStart).split('\n');
    const line = linesBefore.length;
    const col = linesBefore[linesBefore.length - 1].length + 1;
    editorCursorPos.textContent = `Ln ${line}, Col ${col}`;
  }

  if (codingEditorTextarea) {
    codingEditorTextarea.addEventListener('keyup', updateCursorPos);
    codingEditorTextarea.addEventListener('click', updateCursorPos);
    codingEditorTextarea.addEventListener('input', updateCursorPos);
  }

  if (codingLanguageSelect) {
    codingLanguageSelect.addEventListener('change', () => {
      const lang = codingLanguageSelect.value || 'javascript';
      submittedLanguage = lang;
      if (codingEditorTextarea) {
        codingEditorTextarea.value = CODE_TEMPLATES[lang] || '';
        activeErrorLine = null;
        updateCodingGutter();
        updateCursorPos();
      }
    });
  }

  // Utility buttons listeners
  const btnLcCopy = document.getElementById('btn-lc-copy');
  if (btnLcCopy) {
    btnLcCopy.addEventListener('click', () => {
      if (!codingEditorTextarea) return;
      navigator.clipboard.writeText(codingEditorTextarea.value);
      const originalHTML = btnLcCopy.innerHTML;
      btnLcCopy.innerHTML = `<svg class="w-3.5 h-3.5 text-accent-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>`;
      setTimeout(() => {
        btnLcCopy.innerHTML = originalHTML;
      }, 1500);
    });
  }

  const btnLcWrap = document.getElementById('btn-lc-wrap');
  let isLineWrapped = true;
  if (btnLcWrap) {
    btnLcWrap.addEventListener('click', () => {
      if (!codingEditorTextarea) return;
      isLineWrapped = !isLineWrapped;
      if (isLineWrapped) {
        codingEditorTextarea.classList.remove('whitespace-pre');
        codingEditorTextarea.classList.add('whitespace-pre-wrap');
        btnLcWrap.classList.add('text-accent-blue');
      } else {
        codingEditorTextarea.classList.remove('whitespace-pre-wrap');
        codingEditorTextarea.classList.add('whitespace-pre');
        btnLcWrap.classList.remove('text-accent-blue');
      }
    });
  }

  const btnLcReset = document.getElementById('btn-lc-reset');
  if (btnLcReset) {
    btnLcReset.addEventListener('click', () => {
      if (!codingEditorTextarea) return;
      if (confirm("Are you sure you want to reset your code to the default template? This will discard your current edits.")) {
        const lang = codingLanguageSelect.value || 'javascript';
        codingEditorTextarea.value = CODE_TEMPLATES[lang] || '';
        activeErrorLine = null;
        updateCodingGutter();
        updateCursorPos();
      }
    });
  }

  const btnLcExpand = document.getElementById('btn-lc-expand');
  if (btnLcExpand) {
    btnLcExpand.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(err => {
          console.warn("Fullscreen request failed", err);
        });
      } else {
        document.exitFullscreen();
      }
    });
  }

  // Handle Tab switches in Console pane
  if (tabLcTestcase && tabLcResult) {
    tabLcTestcase.addEventListener('click', () => {
      tabLcTestcase.className = "flex items-center gap-1 text-ink font-semibold cursor-pointer border-b border-accent-yellow py-2 h-8";
      tabLcResult.className = "flex items-center gap-1 hover:text-ink cursor-pointer font-semibold py-2";
      
      // Update output display
      lcConsoleOutput.innerHTML = `
        <div class="space-y-3 font-sans text-xs text-mute w-full">
          <p class="font-mono text-[10px] text-mute/50">Standard Test Cases:</p>
          <div class="bg-white/5 border border-white/5 rounded p-3 font-mono text-[11px] space-y-1">
            <p><strong class="text-ink">Case 1:</strong> nums = [2, 7, 11, 15], target = 9</p>
            <p><strong class="text-ink">Case 2:</strong> nums = [3, 2, 4], target = 6</p>
            <p><strong class="text-ink">Case 3:</strong> nums = [3, 3], target = 6</p>
          </div>
        </div>
      `;
    });

    tabLcResult.addEventListener('click', () => {
      tabLcResult.className = "flex items-center gap-1 text-ink font-semibold cursor-pointer border-b border-accent-yellow py-2 h-8";
      tabLcTestcase.className = "flex items-center gap-1 hover:text-ink cursor-pointer font-semibold py-2";
      
      // Update output display
      lcConsoleOutput.innerHTML = `
        <span class="italic text-[10px] text-mute/50">Run your code to see the testcase results here.</span>
      `;
    });
  }

  // Compiler output formatting
  function displayCompileError(message, lineNum, charNum, codeLineText = "") {
    activeErrorLine = lineNum;
    updateCodingGutter();

    // Select the "Test Result" tab
    if (tabLcResult && tabLcTestcase) {
      tabLcResult.className = "flex items-center gap-1 text-ink font-semibold cursor-pointer border-b border-accent-yellow py-2 h-8";
      tabLcTestcase.className = "flex items-center gap-1 hover:text-ink cursor-pointer font-semibold py-2";
    }

    lcConsoleOutput.innerHTML = `
      <div class="text-red-500 font-bold text-sm mb-2">Compile Error</div>
      <div class="bg-red-950/20 border border-red-500/20 p-3 rounded-lg text-red-200/90 text-[11px] leading-relaxed w-full">
        <p class="font-bold mb-1">Line ${lineNum}: Char ${charNum}: error: ${message}</p>
        <p class="font-mono text-mute/40 mt-2">${lineNum} |  ${escapeHTML(codeLineText) || '   '}</p>
        <p class="font-mono text-red-400">  |  ${' '.repeat(Math.max(charNum - 1, 0))}^</p>
        <p class="mt-2 text-mute/30 text-[10px]">1 error generated.</p>
      </div>
    `;
    
    // Highlight the lines scroll position if possible or just log
    console.warn(`Compile error at line ${lineNum}, char ${charNum}: ${message}`);
  }

  function displayMockAccepted(resultOutput = "[0,1]", expectedOutput = "[0,1]") {
    activeErrorLine = null;
    updateCodingGutter();

    // Select the "Test Result" tab
    if (tabLcResult && tabLcTestcase) {
      tabLcResult.className = "flex items-center gap-1 text-ink font-semibold cursor-pointer border-b border-accent-yellow py-2 h-8";
      tabLcTestcase.className = "flex items-center gap-1 hover:text-ink cursor-pointer font-semibold py-2";
    }

    lcConsoleOutput.innerHTML = `
      <div class="text-green-500 font-bold text-sm mb-1.5 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        <span>Accepted</span>
      </div>
      <div class="text-[11px] text-mute space-y-1.5 bg-white/5 p-3 rounded border border-white/5 w-full">
        <p><strong class="text-ink">Input:</strong> nums = [2, 7, 11, 15], target = 9</p>
        <p><strong class="text-ink">Output:</strong> <span class="font-bold text-ink">${resultOutput}</span></p>
        <p><strong class="text-ink">Expected:</strong> <span class="font-bold text-ink">${expectedOutput}</span></p>
        <div class="h-[1px] bg-white/5 my-2"></div>
        <p class="text-green-400 font-sans text-[10px] font-semibold">All standard test cases passed!</p>
      </div>
    `;
  }

  // Click handler to compile/run code
  if (btnRunCode) {
    btnRunCode.addEventListener('click', () => {
      if (!codingEditorTextarea || !lcConsoleOutput) return;

      const userCode = codingEditorTextarea.value;
      const lang = codingLanguageSelect.value || 'javascript';
      
      // Select the "Test Result" tab
      if (tabLcResult && tabLcTestcase) {
        tabLcResult.className = "flex items-center gap-1 text-ink font-semibold cursor-pointer border-b border-accent-yellow py-2 h-8";
        tabLcTestcase.className = "flex items-center gap-1 hover:text-ink cursor-pointer font-semibold py-2";
      }

      lcConsoleOutput.innerHTML = `<span class="animate-pulse text-[11px] text-accent-yellow">Running tests...</span>`;

      // Small simulation delay
      setTimeout(() => {
        if (lang === 'javascript') {
          try {
            // Real client-side test execution!
            const testCaseInput = [2, 7, 11, 15];
            const testCaseTarget = 9;
            
            const runnerCode = `
              ${userCode}
              
              if (typeof solve === 'function') {
                return solve(arguments[0], arguments[1]);
              } else if (typeof twoSum === 'function') {
                return twoSum(arguments[0], arguments[1]);
              }
              throw new Error("Function 'solve' or 'twoSum' not found. Please declare solve(nums, target).");
            `;
            
            const userFn = new Function('nums', 'target', runnerCode);
            const result = userFn(testCaseInput, testCaseTarget);
            
            if (!Array.isArray(result)) {
              throw new Error(`Returned value is not an Array. Got: ${typeof result}`);
            }
            
            const sorted = [...result].sort((a,b) => a-b);
            if (sorted.length === 2 && sorted[0] === 0 && sorted[1] === 1) {
              displayMockAccepted(JSON.stringify(result));
            } else {
              activeErrorLine = null;
              updateCodingGutter();
              lcConsoleOutput.innerHTML = `
                <div class="text-red-500 font-bold text-sm mb-1 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                  Wrong Answer
                </div>
                <div class="text-[11px] text-mute space-y-1 bg-white/5 p-3 rounded border border-white/5">
                  <p><strong class="text-ink">Input:</strong> nums = [2, 7, 11, 15], target = 9</p>
                  <p><strong class="text-red-400 font-bold"><strong class="text-ink">Output:</strong> ${JSON.stringify(result)}</strong></p>
                  <p><strong class="text-ink">Expected:</strong> [0, 1]</p>
                </div>
              `;
            }
          } catch (err) {
            // Find line number
            let lineNum = 1;
            let charNum = 1;
            const stackMatch = err.stack ? err.stack.match(/<anonymous>:(\d+):(\d+)/) : null;
            let codeLine = "";
            if (stackMatch) {
              lineNum = parseInt(stackMatch[1], 10) - 2; // Offset the Function shell wrapper lines
              charNum = parseInt(stackMatch[2], 10);
              const lines = userCode.split('\n');
              if (lineNum > 0 && lineNum <= lines.length) {
                codeLine = lines[lineNum - 1];
              }
            }
            displayCompileError(err.message, lineNum, charNum, codeLine);
          }
        } else if (lang === 'cpp') {
          if (!userCode.includes('return')) {
            displayCompileError("non-void function does not return a value [-Werror,-Wreturn-type]", 10, 9, "    }");
          } else if (userCode.split('{').length !== userCode.split('}').length) {
            displayCompileError("expected '}' at end of input", 11, 5, "};");
          } else {
            displayMockAccepted("[0,1]");
          }
        } else if (lang === 'python') {
          if (userCode.includes('def solve') && !userCode.includes('def solve(')) {
            displayCompileError("invalid syntax", 4, 18, "def solve");
          } else if (!userCode.includes('return')) {
            displayCompileError("expected an indented block", 5, 8, "    # Write your code here");
          } else {
            displayMockAccepted("[0, 1]");
          }
        } else if (lang === 'java') {
          if (!userCode.includes('return')) {
            displayCompileError("missing return statement", 8, 9, "    }");
          } else {
            displayMockAccepted("[0, 1]");
          }
        }
      }, 600);
    });
  }

  // --- CODING WORKSPACE LOGICS & INTERACTIVE CONTROLLERS ---
  function escapeHTML(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function formatEquationsAndMath(str) {
    if (!str) return '';
    return str
      .replace(/<=/g, '&le;')
      .replace(/>=/g, '&ge;')
      .replace(/(\d+)\^([a-zA-Z0-9\-+]+)/g, '$1<sup>$2</sup>');
  }

  function renderExampleContainer(lines) {
    if (lines.length === 0) return '';
    let html = `<div class="bg-[#141414]/75 border border-white/5 p-4 rounded-xl font-sans text-xs space-y-2 my-3 shadow-inner leading-relaxed text-ink/90">`;
    lines.forEach(line => {
      let trimmed = line.trim();
      if (!trimmed) return;
      
      // mathematical notations
      trimmed = formatEquationsAndMath(trimmed);
      
      // Inline backticks formatter
      trimmed = trimmed.replace(/`([^`]+)`/g, '<code class="bg-[#2c2c2c] px-1.5 py-0.5 rounded text-accent-yellow font-mono text-[11px] border border-white/5">$1</code>');

      if (trimmed.startsWith('Input:')) {
        const val = trimmed.substring(6).trim();
        html += `<div><strong class="text-ink font-semibold">Input:</strong> <span class="font-mono text-ink/90">${val}</span></div>`;
      } else if (trimmed.startsWith('Output:')) {
        const val = trimmed.substring(7).trim();
        html += `<div><strong class="text-ink font-semibold">Output:</strong> <span class="font-mono text-ink/90">${val}</span></div>`;
      } else if (trimmed.startsWith('Explanation:')) {
        const val = trimmed.substring(12).trim();
        html += `<div><strong class="text-ink font-semibold">Explanation:</strong> <span>${val}</span></div>`;
      } else {
        html += `<div>${trimmed}</div>`;
      }
    });
    html += `</div>`;
    return html;
  }

  function formatProblemBody(text) {
    if (!text) return '';
    
    const lines = text.split('\n');
    let outputHTML = '';
    let inExample = false;
    let exampleLines = [];
    let inConstraints = false;

    for (let i = 0; i < lines.length; i++) {
      let line = lines[i];
      let trimmed = line.trim();

      // Check for Example header
      if (/^(?:###\s*|#+\s*|\*\*+)?Example\s*\d+:?/i.test(trimmed)) {
        if (inExample) {
          outputHTML += renderExampleContainer(exampleLines);
          exampleLines = [];
        }
        inExample = true;
        inConstraints = false;
        
        const cleanHeader = trimmed.replace(/^[#\*\s]+/, '').replace(/[#\*\s]+$/, '');
        outputHTML += `<p class="font-semibold text-ink mt-5 mb-1">${cleanHeader}</p>`;
        continue;
      }

      // Check for Constraints header
      if (/^(?:###\s*|#+\s*|\*\*+)?Constraints:?/i.test(trimmed)) {
        if (inExample) {
          outputHTML += renderExampleContainer(exampleLines);
          inExample = false;
          exampleLines = [];
        }
        inConstraints = true;
        
        outputHTML += `<p class="font-semibold text-ink mt-5 mb-2 flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-accent-yellow" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>Constraints:</p>`;
        continue;
      }

      // Check for generic header
      if (trimmed.startsWith('###') || (trimmed.startsWith('**') && trimmed.endsWith('**') && trimmed.length < 50)) {
        if (inExample) {
          outputHTML += renderExampleContainer(exampleLines);
          inExample = false;
          exampleLines = [];
        }
        inConstraints = false;
        
        const cleanHeader = trimmed.replace(/^[#\*\s]+/, '').replace(/[#\*\s]+$/, '');
        outputHTML += `<h4 class="text-xs font-mono font-bold text-ink/95 mt-4 mb-2 uppercase tracking-wider">${cleanHeader}</h4>`;
        continue;
      }

      if (inExample) {
        exampleLines.push(line);
      } else if (inConstraints) {
        if (!trimmed) continue;
        // Format constraints list item
        let cleanBullet = trimmed.replace(/^[\-\*\s\d\.]+\s*/, '');
        cleanBullet = formatEquationsAndMath(cleanBullet);
        cleanBullet = cleanBullet.replace(/`([^`]+)`/g, '<code class="bg-[#2c2c2c] px-1.5 py-0.5 rounded text-accent-yellow font-mono text-[11px] border border-white/5">$1</code>');
        outputHTML += `<div class="flex items-start gap-2 text-mute/85 text-[11px] pl-2 mb-1.5">
          <span class="text-accent-yellow font-mono mt-0.5">•</span>
          <span>${cleanBullet}</span>
        </div>`;
      } else {
        if (!trimmed) {
          outputHTML += `<div class="h-2"></div>`;
          continue;
        }
        let formattedLine = formatEquationsAndMath(trimmed);
        formattedLine = formattedLine.replace(/`([^`]+)`/g, '<code class="bg-[#2c2c2c] px-1.5 py-0.5 rounded text-accent-yellow font-mono text-[11px] border border-white/5">$1</code>');
        formattedLine = formattedLine.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-ink font-semibold">$1</strong>');
        outputHTML += `<p class="mb-2 text-ink/80 text-xs">${formattedLine}</p>`;
      }
    }

    if (inExample && exampleLines.length > 0) {
      outputHTML += renderExampleContainer(exampleLines);
    }

    return outputHTML;
  }

  function displayCodingProblem(questionRaw) {
    let title = "Two Sum";
    let body = questionRaw;
    
    const lines = questionRaw.split('\n');
    if (lines.length > 0) {
      let titleIndex = 0;
      while (titleIndex < lines.length && !lines[titleIndex].trim()) {
        titleIndex++;
      }
      if (titleIndex < lines.length) {
        const rawTitle = lines[titleIndex];
        title = rawTitle.replace(/Question \d+ of \d+:?/i, "").replace(/^[#\*\s`]+/, '').replace(/[#\*\s`]+$/, '').trim();
        body = lines.slice(titleIndex + 1).join('\n').trim();
      }
    }
    
    codingProblemTitle.textContent = title;
    codingProblemDifficulty.textContent = difficulty;
    
    if (difficulty.includes("Easy")) {
      codingProblemDifficulty.className = "px-2 py-0.5 rounded text-[9px] font-mono font-semibold uppercase bg-accent-green/10 text-accent-green border border-accent-green/20";
    } else if (difficulty.includes("Hard") || difficulty.includes("Expert")) {
      codingProblemDifficulty.className = "px-2 py-0.5 rounded text-[9px] font-mono font-semibold uppercase bg-accent-red/10 text-accent-red border border-accent-red/20";
    } else {
      codingProblemDifficulty.className = "px-2 py-0.5 rounded text-[9px] font-mono font-semibold uppercase bg-accent-yellow/10 text-accent-yellow border border-accent-yellow/20";
    }
    
    codingProblemBody.innerHTML = formatProblemBody(body);
  }

  function startCodingTimer() {
    if (codingTimerInterval) clearInterval(codingTimerInterval);
    updateCodingTimerUI();
    
    codingTimerInterval = setInterval(() => {
      codingSecondsLeft--;
      updateCodingTimerUI();
      
      if (codingSecondsLeft <= 0) {
        clearInterval(codingTimerInterval);
        alert("Time is up for the coding phase! Transitioning to your approach and review questions.");
        handleCodeSubmission(true);
      }
    }, 1000);
  }

  function updateCodingTimerUI() {
    if (!codingTimerPill) return;
    const mins = Math.floor(codingSecondsLeft / 60);
    const secs = codingSecondsLeft % 60;
    codingTimerPill.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    
    if (codingSecondsLeft < 120) {
      codingTimerPill.className = "px-2.5 py-0.5 rounded-full border border-accent-red/50 text-accent-red font-bold animate-pulse text-[11px]";
    } else {
      codingTimerPill.className = "px-2.5 py-0.5 rounded-full border border-accent-blue/30 text-accent-blue font-bold animate-pulse text-[11px]";
    }
  }

  async function handleCodeSubmission(isTimeExpired) {
    if (codingTimerInterval) {
      clearInterval(codingTimerInterval);
      codingTimerInterval = null;
    }
    stopHintMic();
    hideCodingHintToast();
    
    submittedCode = codingEditorTextarea.value.trim();
    
    // Switch views
    codingWorkspace.classList.add('hidden');
    standardWorkspace.classList.remove('hidden');
    
    // Reparent orb back
    const coreOrb = document.getElementById('interviewer-core-orb');
    const wrapper = document.getElementById('orb-wrapper');
    if (coreOrb && wrapper) {
      coreOrb.style.width = '';
      coreOrb.style.height = '';
      wrapper.appendChild(coreOrb);
    }
    
    isCodingMode = false;
    setCodingModeLayout(false);
    isFollowUpMode = true;
    
    // Clear standard text areas
    textareaAnswer.value = '';
    liveSubtitleBox.textContent = "Tap microphone or type to answer...";
    liveSubtitleBox.contentEditable = "false";
    liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-mute/40 overflow-y-auto text-center italic flex items-center justify-center select-none";
    
    setOrbState('thinking');
    questionText.innerHTML = '<span class="text-mute animate-pulse">Evaluating solution draft...</span>';
    
    try {
      const codePrompt = `Candidate has submitted the following code in ${submittedLanguage} for the problem "${codingProblemTitle.textContent}":\n\n\`\`\`${submittedLanguage}\n${submittedCode}\n\`\`\`\n\nTimer status: ${isTimeExpired ? 'Time Expired' : 'Submitted within limit'}.\n\nAI Interviewer: Please ask the candidate what their approach was to solving the problem, and to explain their time and space complexity. Keep the response concise, spoken as the voice agent.`;
      
      chatHistory.push({
        role: "user",
        parts: [{ text: codePrompt }]
      });
      
      const followUpQuestion = await getNextQuestion(apiKey, {
        resumeText,
        topics: selectedTopics,
        difficulty,
        questionCount
      }, chatHistory);
      
      chatHistory.push({
        role: "model",
        parts: [{ text: followUpQuestion }]
      });
      
      questionsList.push(followUpQuestion);
      displayQuestion(followUpQuestion);
    } catch (err) {
      console.error(err);
      questionText.textContent = "Submission evaluated. What was your approach to solving the problem and what is the time complexity?";
      setOrbState('idle');
    }
  }

  function startHintMic() {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
      alert("Speech recognition is not supported in this browser. Please type or query verbally.");
      return;
    }
    
    hintSpeechRecognition = new SpeechRecognition();
    hintSpeechRecognition.lang = 'en-US';
    hintSpeechRecognition.interimResults = false;
    hintSpeechRecognition.maxAlternatives = 1;
    
    hintSpeechRecognition.onstart = () => {
      isHintRecording = true;
      btnCodingHintMic.classList.remove('bg-slate-900/60');
      btnCodingHintMic.classList.add('bg-accent-red/20', 'border-accent-red/40', 'animate-pulse');
      codingHintToast.textContent = "Listening for your query or hint request...";
      codingHintToast.classList.remove('opacity-0', 'translate-y-2');
      codingHintToast.classList.add('opacity-100', 'translate-y-0');
    };
    
    hintSpeechRecognition.onresult = async (event) => {
      const query = event.results[0][0].transcript.trim();
      if (query) {
        codingHintToast.textContent = `Asking: "${query}"...`;
        await fetchHintFromInterviewer(query);
      } else {
        codingHintToast.textContent = "No speech detected. Click mic to ask again.";
        setTimeout(hideCodingHintToast, 3500);
      }
    };
    
    hintSpeechRecognition.onerror = (event) => {
      console.error("Hint mic error:", event.error);
      codingHintToast.textContent = "Speech recognition failed. Try speaking closer to mic.";
      stopHintMic();
      setTimeout(hideCodingHintToast, 3500);
    };
    
    hintSpeechRecognition.onend = () => {
      isHintRecording = false;
      btnCodingHintMic.classList.remove('bg-accent-red/20', 'border-accent-red/40', 'animate-pulse');
      btnCodingHintMic.classList.add('bg-slate-900/60');
    };
    
    hintSpeechRecognition.start();
  }
  
  function stopHintMic() {
    if (hintSpeechRecognition) {
      try { hintSpeechRecognition.stop(); } catch(e) {}
    }
  }
  
  function hideCodingHintToast() {
    codingHintToast.classList.remove('opacity-100', 'translate-y-0');
    codingHintToast.classList.add('opacity-0', 'translate-y-2');
  }

  async function fetchHintFromInterviewer(query) {
    setOrbState('thinking');
    try {
      const problemTitle = codingProblemTitle.textContent;
      const problemDesc = codingProblemBody.textContent;
      const questionPrompt = `Problem: "${problemTitle}". Details: "${problemDesc}". Context: User asked: "${query}". Provide a short, direct hint or clarification in 1 or 2 sentences max. Do not output code blocks. Speak directly to the candidate.`;
      
      const hintResponse = await getHint(apiKey, questionPrompt, codingEditorTextarea.value.trim());
      
      codingHintToast.innerHTML = `<strong>Interviewer:</strong> ${hintResponse}`;
      
      setOrbState('speaking');
      speakQuestion(hintResponse);
    } catch (err) {
      console.error(err);
      codingHintToast.textContent = "Failed to fetch hint. Try again.";
      setOrbState('idle');
      setTimeout(hideCodingHintToast, 3500);
    }
  }

  if (btnSubmitCode) {
    btnSubmitCode.addEventListener('click', () => {
      if (confirm("Submit code solution and begin follow-up approach questions?")) {
        handleCodeSubmission(false);
      }
    });
  }

  if (btnCodingHintMic) {
    btnCodingHintMic.addEventListener('click', async () => {
      unlockAudioContextAndPlayer();
      if (isHintRecording) {
        stopHintMic();
      } else {
        const hasMic = await checkMicAndInitialize();
        if (hasMic) {
          if (isVirtualMic) {
            const query = prompt("No microphone detected. Type your question for the interviewer:");
            if (query && query.trim().length >= 3) {
              fetchHintFromInterviewer(query.trim());
            }
          } else {
            startHintMic();
          }
        } else {
          alert("Microphone permission blocked or unavailable. Please adjust browser settings.");
        }
      }
    });
  }

  btnMicToggle.addEventListener('click', async () => {
    if (isMuted) {
      micEnabled = true;
      startRecording();
    } else {
      micEnabled = false;
      stopRecording();
      if (!isVirtualMic) {
        await transcribeRecordedVoice();
      }
    }
  });

  // --- LANDING VIEW NAVIGATIONS ---
  const btnGetStarted = document.getElementById('btn-get-started');
  btnGetStarted?.addEventListener('click', () => {
    switchViewWithOrb('landing', 'setup', null, true);
  });

  const navLogo = document.getElementById('nav-logo');
  navLogo?.addEventListener('click', () => {
    switchView('landing');
  });

  // --- VIEW SETUP TRANSITIONS AND BOOTSTRAPPING ---
  btnStart.addEventListener('click', async () => {
    unlockAudioContextAndPlayer();
    if (!apiKey) {
      console.warn("No Gemini API key configured. Proceeding in local fallback mode.");
      apiKey = "LOCAL_FALLBACK";
      updateApiConnectionStatus(false);
    }

    if (selectedTopics.length === 0) {
      alert("Please select at least one interview focus topic.");
      return;
    }

    // Read input configurations
    difficulty = selectDifficulty.value;
    questionCount = parseInt(selectCount.value, 10) || 5;
    
    // Fetch manual resume text if paste mode is activated
    if (!inputResumeText.classList.contains('hidden')) {
      resumeText = inputResumeText.value.trim();
    }

    // Initialize interview variables
    currentQuestionIndex = 0;
    chatHistory = [];
    questionsList = [];
    answersList = [];
    totalFillersAccumulated = 0;
    allSessionWpms = [];

  function setCodingModeLayout(active) {
    const mainEl = document.querySelector('main');
    if (active) {
      if (mainEl) {
        mainEl.classList.remove('items-center', 'justify-center');
        mainEl.classList.add('items-stretch');
      }
      if (views.interview) {
        views.interview.classList.remove('max-w-4xl', 'max-w-6xl', 'px-6', 'py-8', 'mx-auto');
        views.interview.classList.add('max-w-none', 'w-full', 'h-full', 'px-4', 'py-2', 'flex-grow');
      }
      if (codingWorkspace) {
        codingWorkspace.classList.remove('h-[650px]', 'rounded-2xl');
        codingWorkspace.classList.add('h-[calc(100vh-95px)]', 'rounded-none');
      }
    } else {
      if (mainEl) {
        mainEl.classList.remove('items-stretch');
        mainEl.classList.add('items-center', 'justify-center');
      }
      if (views.interview) {
        views.interview.classList.remove('max-w-none', 'w-full', 'h-full', 'px-4', 'py-2', 'flex-grow');
        views.interview.classList.add('max-w-4xl', 'px-6', 'py-8', 'mx-auto');
      }
      if (codingWorkspace) {
        codingWorkspace.classList.remove('h-[calc(100vh-95px)]', 'rounded-none');
        codingWorkspace.classList.add('h-[650px]', 'rounded-2xl');
      }
    }
  }

    // Check if Coding (DSA) is selected
    if (selectedTopics.includes("Coding (DSA)")) {
      isCodingMode = true;
      standardWorkspace.classList.add('hidden');
      codingWorkspace.classList.remove('hidden');

      setCodingModeLayout(true);

      // Move core orb canvas to compact container
      const coreOrb = document.getElementById('interviewer-core-orb');
      if (coreOrb && codingCompactOrb) {
        coreOrb.style.width = '32px';
        coreOrb.style.height = '32px';
        codingCompactOrb.appendChild(coreOrb);
      }

      // Setup difficulty-based timer limits
      let seconds = 1500; // 25 min default
      if (difficulty.includes("Easy")) seconds = 900;
      else if (difficulty.includes("Hard")) seconds = 2400;
      else if (difficulty.includes("Expert")) seconds = 2700;
      codingSecondsLeft = seconds;
      startCodingTimer();

      // Init template in code editor
      submittedLanguage = codingLanguageSelect.value || 'javascript';
      codingEditorTextarea.value = CODE_TEMPLATES[submittedLanguage];
      updateCodingGutter();
    } else {
      isCodingMode = false;
      standardWorkspace.classList.remove('hidden');
      codingWorkspace.classList.add('hidden');

      setCodingModeLayout(false);

      // Move core orb back to standard wrapper if it was moved
      const coreOrb = document.getElementById('interviewer-core-orb');
      const wrapper = document.getElementById('orb-wrapper');
      if (coreOrb && wrapper) {
        coreOrb.style.width = '';
        coreOrb.style.height = '';
        wrapper.appendChild(coreOrb);
      }
    }

    // Switch view to Simulator HUD with morphing ball transition
    switchViewWithOrb('setup', 'interview', async () => {
      if (isCodingMode) return; // Skip standard microphone checks since hint mic is used
      if (isTypingMode) {
        switchToTextMode();
      } else {
        const hasMic = await checkMicAndInitialize();
        if (hasMic) {
          switchToVoiceMode();
        } else {
          switchToTextMode();
          console.warn("Microphone permission or hardware access failed. Falling back to Keyboard Mode silently.");
        }
      }
    }, true);
    
    // Start session timer
    globalSessionStartTime = Date.now();
    startGlobalTimer();
    
    // Trigger initial question generation
    setOrbState('thinking');
    if (isCodingMode) {
      codingProblemTitle.textContent = "Loading...";
      codingProblemBody.innerHTML = '<span class="text-mute animate-pulse text-xs">AI interviewer is writing your coding challenge prompt...</span>';
    } else {
      questionText.innerHTML = '<span class="text-mute animate-pulse">Initializing Interviewer Panel...</span>';
    }
    
    try {
      // Sequence start: User instructs bot to start
      const prompt = `Let's begin the mock interview session. Prompt me with Question 1.`;
      chatHistory.push({
        role: "user",
        parts: [{ text: prompt }]
      });

      const firstQuestion = await getNextQuestion(apiKey, {
        resumeText,
        topics: selectedTopics,
        difficulty,
        questionCount
      }, chatHistory);

      chatHistory.push({
        role: "model",
        parts: [{ text: firstQuestion }]
      });

      questionsList.push(firstQuestion);
      if (isCodingMode) {
        displayCodingProblem(firstQuestion);
        // Play verbal intro using Andrew voice
        speakQuestion(firstQuestion);
      } else {
        displayQuestion(firstQuestion);
      }
    } catch (error) {
      console.error(error);
      if (isCodingMode) {
        codingProblemBody.textContent = `Setup failed: ${error.message}. Double-check your API key and network connection.`;
      } else {
        questionText.textContent = `Setup failed: ${error.message}. Double-check your API key and network connection.`;
      }
      setOrbState('idle');
    }
  });

  // --- DIALOGUE CHAT HISTORY RENDERER ---
  function renderChatHistory() {
    const container = document.getElementById('chat-history-container');
    if (!container) return;

    // Cache active question bubble content before clearing container
    let activeBubbleHTML = null;
    const existingActive = document.getElementById('active-question-bubble');
    if (existingActive) {
      activeBubbleHTML = existingActive.innerHTML;
    }

    container.innerHTML = '';

    const maxLength = Math.max(questionsList.length, answersList.length);
    for (let i = 0; i < maxLength; i++) {
      // 1. Add Interviewer Question
      if (i < questionsList.length) {
        const qRaw = questionsList[i];
        const qText = qRaw.replace(/Question \d+ of \d+:/i, '').trim();

        const qBubble = document.createElement('div');
        qBubble.className = "flex justify-start w-full mb-4 animate-[fadeIn_0.3s_ease-out]";
        
        const qInner = document.createElement('div');
        qInner.className = "max-w-[85%] rounded-2xl rounded-tl-none px-4 py-2.5 bg-white/5 border border-white/10 text-ink/90 text-xs md:text-sm font-light leading-relaxed shadow-sm select-text";
        
        if (i === questionsList.length - 1 && isSpeakingBot) {
          qInner.id = "active-question-bubble";
          if (activeBubbleHTML) {
            qInner.innerHTML = activeBubbleHTML;
          } else {
            qInner.innerHTML = `<span class="flex items-center gap-1.5 py-1" id="active-question-thinking-indicator"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-bounce [animation-duration:1s]"></span><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-bounce [animation-duration:1s] [animation-delay:0.2s]"></span><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-bounce [animation-duration:1s] [animation-delay:0.4s]"></span></span>`;
          }
        } else {
          qInner.textContent = qText;
        }
        
        qBubble.appendChild(qInner);
        container.appendChild(qBubble);
      }

      // 2. Add Candidate Answer
      if (i < answersList.length) {
        const aText = answersList[i];
        const aBubble = document.createElement('div');
        aBubble.className = "flex justify-end w-full mb-4 animate-[fadeIn_0.3s_ease-out]";
        
        const aInner = document.createElement('div');
        aInner.className = "max-w-[85%] rounded-2xl rounded-tr-none px-4 py-2.5 bg-white/10 border border-white/15 text-ink text-xs md:text-sm font-light leading-relaxed shadow-sm text-right select-text";
        aInner.textContent = aText;
        
        aBubble.appendChild(aInner);
        container.appendChild(aBubble);
      }
    }

    // 3. Show live draft text for current unanswered question
    if (questionsList.length > answersList.length) {
      let draftText = "";
      if (isTypingMode) {
        draftText = textareaAnswer.value.trim();
      } else {
        const liveText = liveSubtitleBox.textContent.trim();
        const ignoredPhrases = [
          "Voice transcription will appear here in real time...",
          "Recording your voice... speak now, and click SEND ANSWER when finished.",
          "Transcribing speech with Gemini 1.5 Flash...",
          "No speech detected. Click mic to talk.",
          "Voice was not clear. Try again or click Switch to Type.",
          "Transcription error. Click mic to try again.",
          "Tap microphone or type to answer..."
        ];
        if (liveText && !ignoredPhrases.includes(liveText)) {
          draftText = liveText;
        }
      }

      if (draftText) {
        const draftBubble = document.createElement('div');
        draftBubble.className = "flex justify-end w-full mb-4 opacity-75";
        
        const draftInner = document.createElement('div');
        draftInner.className = "max-w-[85%] rounded-2xl rounded-tr-none px-4 py-2.5 bg-white/5 border border-white/10 border-dashed text-ink/75 text-xs md:text-sm font-light leading-relaxed text-right select-text italic";
        draftInner.textContent = draftText;
        
        draftBubble.appendChild(draftInner);
        container.appendChild(draftBubble);
      }
    }

    // Scroll to bottom
    container.scrollTop = container.scrollHeight;
  }

  // --- INTERVIEW SIMULATOR MECHANICS ---
  function displayQuestion(questionRaw) {
    // Save state
    currentQuestionIndex = questionsList.length;
    questionProgressLabel.textContent = `Question ${currentQuestionIndex} of ${questionCount}`;
    
    // Reset accumulated transcript
    accumulatedTranscript = '';
    
    // Clear typewriter if active
    stopTypewriter();
    stopWordByWordRendering();
    
    // Clear user input card BEFORE rendering chat history so draft bubble doesn't get old text!
    textareaAnswer.value = '';
    liveSubtitleBox.textContent = "Tap microphone or type to answer...";
    liveSubtitleBox.contentEditable = "false";
    liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-mute/40 overflow-y-auto text-center italic flex items-center justify-center select-none";

    isSpeakingBot = true;
    renderChatHistory();

    // Speak aloud
    speakQuestion(questionRaw);

    // Reset HUD metrics for the current question
    currentAnswerStartTime = Date.now();
    currentFillersCount = 0;
    counterFillersText.textContent = '0';
    hudWpmText.textContent = '0 WPM';
    
    // Close hints
    hintDisplay.classList.add('hidden');
  }

  // --- SUBMIT ANSWER LOOP ---
  btnSubmitAnswer.addEventListener('click', async () => {
    unlockAudioContextAndPlayer();
    // If voice mode is active and we are currently recording/not muted
    if (!isTypingMode && !isMuted) {
      stopRecording();
      
      const liveText = liveSubtitleBox.textContent.trim();
      const ignoredPhrases = [
        "Voice transcription will appear here in real time...",
        "Recording your voice... speak now, and click SEND ANSWER when finished.",
        "Transcribing speech with Gemini 1.5 Flash...",
        "No speech detected. Click mic to talk.",
        "Voice was not clear. Try again or click Switch to Type.",
        "Transcription error. Click mic to try again.",
        "Tap microphone or type to answer..."
      ];
      
      const hasLiveTranscript = liveText && !ignoredPhrases.includes(liveText) && liveText.length >= 5;
      
      if (!hasLiveTranscript) {
        if (isVirtualMic) {
          alert("Please type a substantive answer.");
          return;
        }
        micEnabled = false;
        await transcribeRecordedVoice();
        return; // Return early so they can edit the transcription and then submit
      }
    }

    let finalAnswer = "";
    if (!isTypingMode) {
      finalAnswer = liveSubtitleBox.textContent.trim();
      
      const ignoredPhrases = [
        "Voice transcription will appear here in real time...",
        "Recording your voice... speak now, and click SEND ANSWER when finished.",
        "Transcribing speech with Gemini 1.5 Flash...",
        "No speech detected. Click mic to talk.",
        "Voice was not clear. Try again or click Switch to Type.",
        "Transcription error. Click mic to try again.",
        "Tap microphone or type to answer..."
      ];
      
      if (ignoredPhrases.includes(finalAnswer)) {
        finalAnswer = "";
      }
    } else {
      finalAnswer = textareaAnswer.value.trim();
    }

    if (!finalAnswer || finalAnswer.length < 5) {
      alert("Please enter a substantive answer to the question.");
      setOrbState('idle');
      renderChatHistory();
      return;
    }

    // Stop microphone if running
    stopRecording();

    // Track statistics
    totalFillersAccumulated += currentFillersCount;
    const currentWpm = calculateFinalWpm(finalAnswer);
    if (currentWpm > 30) {
      allSessionWpms.push(currentWpm);
    }

    // Save candidate answer
    answersList.push(finalAnswer);
    renderChatHistory();

    // Append current answer to API Chat history
    chatHistory.push({
      role: "user",
      parts: [{ text: finalAnswer }]
    });

    // Check if we reached the question limit
    if (questionsList.length >= questionCount) {
      await endAndGradeInterview();
    } else {
      // Trigger next question query
      setOrbState('thinking');
      
      // Update visual feedback directly via a temporary bubble or a state indicator
      const container = document.getElementById('chat-history-container');
      if (container) {
        const thinkingBubble = document.createElement('div');
        thinkingBubble.id = "thinking-bubble";
        thinkingBubble.className = "flex justify-start w-full mb-4 animate-pulse";
        thinkingBubble.innerHTML = `<div class="max-w-[85%] rounded-2xl rounded-tl-none px-4 py-2.5 bg-white/5 border border-white/10 text-mute text-xs md:text-sm font-light leading-relaxed select-none italic">Analyzing response & formulating next question...</div>`;
        container.appendChild(thinkingBubble);
        container.scrollTop = container.scrollHeight;
      }

      try {
        const nextQ = await getNextQuestion(apiKey, {
          resumeText,
          topics: selectedTopics,
          difficulty,
          questionCount
        }, chatHistory);

        // Remove thinking bubble
        const thinkingEl = document.getElementById('thinking-bubble');
        if (thinkingEl) thinkingEl.remove();

        chatHistory.push({
          role: "model",
          parts: [{ text: nextQ }]
        });

        questionsList.push(nextQ);
        displayQuestion(nextQ);
      } catch (err) {
        console.error(err);
        // Remove thinking bubble
        const thinkingEl = document.getElementById('thinking-bubble');
        if (thinkingEl) thinkingEl.remove();
        
        alert("API connection error: " + err.message + ". Please retry.");
        // rollback answer push so user can retry
        answersList.pop();
        chatHistory.pop();
        setOrbState('idle');
        renderChatHistory();
      }
    }
  });

  // Calculate final WPM for current answer
  function calculateFinalWpm(text) {
    if (currentAnswerStartTime === 0) return 0;
    const elapsedMins = (Date.now() - currentAnswerStartTime) / 60000;
    const words = text.split(/\s+/).filter(w => w.length > 0).length;
    return elapsedMins > 0.05 ? Math.round(words / elapsedMins) : 0;
  }

  // --- DYNAMIC HINTS ENGINE ---
  btnHint.addEventListener('click', async () => {
    if (questionsList.length === 0) return;
    const currentQ = questionsList[questionsList.length - 1];
    const draft = textareaAnswer.value.trim();
    
    btnHint.disabled = true;
    btnHint.querySelector('span').textContent = "FETCHING...";

    try {
      const hint = await getHint(apiKey, currentQ, draft);
      hintTextNode.textContent = hint;
      hintDisplay.classList.remove('hidden');
    } catch (e) {
      console.error(e);
      hintTextNode.textContent = "Unable to fetch hint right now. Think about the core principles.";
      hintDisplay.classList.remove('hidden');
    } finally {
      btnHint.disabled = false;
      btnHint.querySelector('span').textContent = "GET HINT";
    }
  });

  btnCloseHint.addEventListener('click', () => {
    hintDisplay.classList.add('hidden');
  });

  // --- QUIT & EVALUATE EARLY CONTROLS ---
  btnEndEarly.addEventListener('click', () => {
    if (confirm("Are you sure you want to end this interview session? You will receive evaluation feedback only on the questions answered so far.")) {
      stopRecording();
      endAndGradeInterview();
    }
  });

  // --- FINAL GRADING MECHANISM ---
  async function endAndGradeInterview() {
    switchView('grading');
    stopGlobalTimer();

    if (codingTimerInterval) {
      clearInterval(codingTimerInterval);
      codingTimerInterval = null;
    }
    stopHintMic();
    hideCodingHintToast();

    // Cancel speech synthesizer
    if (window.speechSynthesis.speaking) {
      window.speechSynthesis.cancel();
    }
    if (activeAudioElement) {
      activeAudioElement.pause();
      activeAudioElement = null;
    }
    stopWordByWordRendering();
    stopTypewriter();

    try {
      const evaluation = await getFinalEvaluation(apiKey, {
        resumeText,
        topics: selectedTopics,
        difficulty,
        questionCount: questionsList.length
      }, chatHistory);

      renderDashboard(evaluation);
      switchView('analytics');
    } catch (err) {
      console.error(err);
      alert(`Grading failed: ${err.message}. Retrying evaluation...`);
      switchView('interview');
    }
  }

  // --- RENDER PERFORMANCE DASHBOARD ---
  function renderDashboard(data) {
    // 1. Set Score numbers and Radial SVG gauge offsets
    scoreOverallText.textContent = data.overallScore;
    scoreTechText.textContent = `${data.techScore}%`;
    scoreCommText.textContent = `${data.commScore}%`;

    // Radial gauge math: r=40 has circumference = 2 * PI * 40 = 251.2
    const dashoffset = 251.2 - (251.2 * data.overallScore) / 100;
    gaugeIndicator.setAttribute('stroke-dashoffset', dashoffset.toString());
    
    if (data.overallScore >= 80) {
      gaugeIndicator.setAttribute('stroke', '#11ff99'); // success green
    } else if (data.overallScore >= 60) {
      gaugeIndicator.setAttribute('stroke', '#3b9eff'); // accent blue
    } else {
      gaugeIndicator.setAttribute('stroke', '#ff2047'); // accent red
    }

    // 2. Set dimensions progress bars
    barTech.style.width = `${data.techScore}%`;
    barComm.style.width = `${data.commScore}%`;

    // 3. Set filler word count & pacing WPM statistics
    statFillers.textContent = totalFillersAccumulated;
    const avgWpm = allSessionWpms.length > 0 
      ? Math.round(allSessionWpms.reduce((a, b) => a + b, 0) / allSessionWpms.length)
      : 110;
    statWpm.textContent = avgWpm;

    // 4. Summaries & lists
    feedbackSummary.textContent = data.summary;

    feedbackStrengthsList.innerHTML = '';
    data.strengths.forEach(str => {
      const li = document.createElement('li');
      li.className = "flex items-start gap-2.5";
      li.innerHTML = `
        <span class="text-accent-green font-bold mt-0.5">•</span>
        <span>${str}</span>
      `;
      feedbackStrengthsList.appendChild(li);
    });

    feedbackWeaknessesList.innerHTML = '';
    data.weaknesses.forEach(weak => {
      const li = document.createElement('li');
      li.className = "flex items-start gap-2.5";
      li.innerHTML = `
        <span class="text-accent-red font-bold mt-0.5">•</span>
        <span>${weak}</span>
      `;
      feedbackWeaknessesList.appendChild(li);
    });

    // 5. Build question timeline review list
    timelineContainer.innerHTML = '';
    data.questions.forEach((q, idx) => {
      const isBehavioral = q.starCheck?.applicable;
      let starHtml = '';
      
      if (isBehavioral) {
        starHtml = `
          <div class="mt-3 border-t border-white/5 pt-2">
