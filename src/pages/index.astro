  // --- SPEECH RECOGNITION & MEDIARECORDER PIPELINE (STT) ---
  async function initAudioRecorder() {
    try {
      // 0. Stop old stream tracks to release microphone hardware and reset state
      if (currentStream) {
        try {
          currentStream.getTracks().forEach(track => track.stop());
        } catch (e) {}
        currentStream = null;
      }

      let stream;
      try {
        stream = await navigator.mediaDevices.getUserMedia({ 
          audio: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true
          } 
        });
      } catch (constraintsError) {
        console.warn("Advanced audio constraints failed, retrying with basic constraints...", constraintsError);
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      }
      currentStream = stream;
      
      // Initialize Web Audio API Analyser Node and Noise Filtering
      if (!audioContext) {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        
        // 1. Create source
        audioSource = audioContext.createMediaStreamSource(stream);
        
        // 1.5. Create Gain Node to boost microphone sensitivity by 4.0x (~12dB)
        gainNode = audioContext.createGain();
        gainNode.gain.value = 4.0;
        
        // 2. Create highpass filter to cut off low frequency rumble (e.g. traffic, AC hum, below 150Hz)
        const hpFilter = audioContext.createBiquadFilter();
        hpFilter.type = 'highpass';
        hpFilter.frequency.value = 150;
        
        // 3. Create lowpass filter to cut off high frequency hiss and click noise (above 3500Hz)
        const lpFilter = audioContext.createBiquadFilter();
        lpFilter.type = 'lowpass';
        lpFilter.frequency.value = 3500;
        
        // 4. Create peaking filter to boost standard human speech frequency range (around 1.8kHz)
        const speechBoostFilter = audioContext.createBiquadFilter();
        speechBoostFilter.type = 'peaking';
        speechBoostFilter.frequency.value = 1800; // Center frequency
        speechBoostFilter.Q.value = 1.0;
        speechBoostFilter.gain.value = 6; // Boost by 6dB
        
        // 5. Create Dynamics Compressor to level audio volume (limits loud transients, boosts quiet words)
        const compressor = audioContext.createDynamicsCompressor();
        compressor.threshold.value = -24; // dB
        compressor.knee.value = 30; // dB
        compressor.ratio.value = 12;
        compressor.attack.value = 0.003; // seconds
        compressor.release.value = 0.25; // seconds
        
        // 6. Create Analyser Node for visualizer
        analyserNode = audioContext.createAnalyser();
        analyserNode.fftSize = 64; // 32 frequency bins
        frequencyData = new Uint8Array(analyserNode.frequencyBinCount);
        
        // 7. Create MediaStream destination node to record the filtered audio
        const destination = audioContext.createMediaStreamDestination();
        
        // Connect the Web Audio chain
        audioSource.connect(gainNode);
        gainNode.connect(hpFilter);
        hpFilter.connect(lpFilter);
        lpFilter.connect(speechBoostFilter);
        speechBoostFilter.connect(compressor);
        compressor.connect(destination);
        
        // Connect compressor to analyser for visual feedback of filtered stream
        compressor.connect(analyserNode);
        
        filteredStream = destination.stream;
      } else {
        // Re-route the new media stream source to our existing audio graph
        if (audioSource) {
          try {
            audioSource.disconnect();
          } catch (e) {}
        }
        audioSource = audioContext.createMediaStreamSource(stream);
        audioSource.connect(gainNode);
      }
      
      // Explicitly resume audioContext if browser or autoplay policy suspended it
      if (audioContext && audioContext.state === 'suspended') {
        await audioContext.resume().catch(e => console.warn("Failed to resume audioContext:", e));
      }

      // Recreate MediaRecorder to attach event handlers directly to the new stream
      if (mediaRecorder) {
        try {
          mediaRecorder.ondataavailable = null;
          mediaRecorder.onstop = null;
        } catch (e) {}
      }
      
      mediaRecorder = new MediaRecorder(filteredStream || stream);
      mediaRecorder.ondataavailable = (event) => {
        if (event.data && event.data.size > 0) {
          audioChunks.push(event.data);
        }
      };
      mediaRecorder.onstop = () => {
        const blob = new Blob(audioChunks, { type: 'audio/webm' });
        if (currentRecordingResolver) {
          currentRecordingResolver(blob);
          currentRecordingResolver = null;
        }
        if (audioResolve) {
          audioResolve(blob);
          audioResolve = null;
        }
      };

      isVirtualMic = false;
      return true;
    } catch (err) {
      console.warn("Microphone not available or permission denied. Falling back to Virtual Mic simulation.", err);
      isVirtualMic = true;
      return true;
    }
  }

  function setupSpeechRecognition() {
    if (!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
      console.warn("Speech recognition not supported in this browser. Live preview disabled; falling back to direct audio upload.");
      isTypingMode = true;
      const btnToggle = document.getElementById('btn-toggle-input');
      if (btnToggle) btnToggle.classList.add('hidden');
      return;
    }

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = 'en-US';

    recognition.onstart = () => {
      if (!isSpeakingBot) {
        setOrbState('listening');
        micInstructions.textContent = "Listening... speak now";
        btnMicToggle.className = "w-16 h-16 rounded-full bg-accent-green/80 border border-white/20 shadow-[0_0_25px_rgba(16,185,129,0.5)] flex items-center justify-center cursor-pointer hover:scale-[1.05] active:scale-[0.95] transition-all group";
      }
    };

    recognition.onresult = (event) => {
      let interimTranscript = '';
      let finalTranscript = '';

      for (let i = 0; i < event.results.length; ++i) {
        if (event.results[i].isFinal) {
          finalTranscript += event.results[i][0].transcript + ' ';
        } else {
          interimTranscript += event.results[i][0].transcript;
        }
      }

      const combinedText = (accumulatedTranscript + finalTranscript + interimTranscript).trim();
      if (combinedText) {
        liveSubtitleBox.textContent = combinedText;
        liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-ink/90 overflow-y-auto text-left select-all";
        
        // Save current answer
        textareaAnswer.value = combinedText;

        // Render live candidate response bubble
        renderChatHistory();

        // Count filler words in real time
        countFillerWords(combinedText);

        // Track live speech WPM
        calculateWpm(combinedText);
      }
    };

    recognition.onerror = (event) => {
      console.error("Speech Recognition Error:", event.error);
      if (event.error === 'not-allowed') {
        alert("Microphone permission denied. Switched to manual typing mode.");
        switchToTextMode();
      }
    };

    recognition.onend = () => {
      // Auto-restart if we are in speech mode, mic is active, and interviewer is NOT speaking
      if (state === 'interview' && micEnabled && !isTypingMode && !isSpeakingBot) {
        try {
          accumulatedTranscript = textareaAnswer.value.trim();
          if (accumulatedTranscript) accumulatedTranscript += ' ';
          recognition.start();
        } catch (err) {}
      } else if (!micEnabled || isTypingMode) {
        btnMicToggle.className = "w-16 h-16 rounded-full bg-slate-900/60 border border-white/10 flex items-center justify-center cursor-pointer hover:scale-[1.05] active:scale-[0.95] transition-all group shadow-md";
        micInstructions.textContent = "Microphone muted. Tap to talk";
      }
    };
  }

  async function startRecording() {
    isMuted = false;
    currentAnswerStartTime = Date.now();
    audioChunks = [];
    currentRecordingPromise = new Promise((resolve) => {
      currentRecordingResolver = resolve;
    });

    const hasMicAccess = await initAudioRecorder();
    if (!hasMicAccess) {
      alert("Microphone permission or hardware access failed.\n\nPlease check your system settings and allow microphone access in your browser to talk.");
      isMuted = true;
      switchToTextMode();
      return;
    }

    // Freshly initialize speech recognition instance to avoid browser lifecycle issues
    if (!isVirtualMic) {
      setupSpeechRecognition();
    }

    if (isVirtualMic) {
      setOrbState('listening');
      micInstructions.textContent = "Virtual Mic active. Type your answer to transcribe in real-time.";
      btnMicToggle.className = "w-16 h-16 rounded-full bg-accent-green/80 border border-white/20 shadow-[0_0_25px_rgba(16,185,129,0.5)] flex items-center justify-center cursor-pointer hover:scale-[1.05] active:scale-[0.95] transition-all group";
      
      // Make live subtitle box editable and focused
      liveSubtitleBox.contentEditable = "true";
      liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-accent-blue/40 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-ink/90 overflow-y-auto text-left focus:outline-none focus:border-accent-blue/40 select-text";
      if (liveSubtitleBox.textContent === "Tap microphone or type to answer..." || liveSubtitleBox.textContent.includes("Microphone muted")) {
        liveSubtitleBox.textContent = "";
      }
      liveSubtitleBox.focus();
      
      // Handle real-time typing events
      liveSubtitleBox.oninput = () => {
        lastKeyPressTime = Date.now();
        const text = liveSubtitleBox.textContent || "";
        textareaAnswer.value = text;
        countFillerWords(text);
        calculateWpm(text);
        renderChatHistory();
      };
      
      return;
    }

    if (mediaRecorder && mediaRecorder.state === 'inactive') {
      try {
        mediaRecorder.start();
      } catch (err) {
        console.error("Failed to start MediaRecorder:", err);
      }
    }

    if (recognition) {
      try {
        accumulatedTranscript = textareaAnswer.value.trim();
        if (accumulatedTranscript) accumulatedTranscript += ' ';
        recognition.start();
      } catch (e) {}
    } else {
      // Firefox or other unsupported browsers
      setOrbState('listening');
      micInstructions.textContent = "Recording... speak now";
      btnMicToggle.className = "w-16 h-16 rounded-full bg-accent-green/80 border border-white/20 shadow-[0_0_25px_rgba(16,185,129,0.5)] flex items-center justify-center cursor-pointer hover:scale-[1.05] active:scale-[0.95] transition-all group";
      liveSubtitleBox.textContent = "Recording your voice... speak now, and click SEND ANSWER when finished.";
      liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-ink/90 overflow-y-auto text-center italic flex items-center justify-center select-none";
    }
  }

  async function transcribeRecordedVoice() {
    const liveText = liveSubtitleBox.textContent.trim();
    const ignoredPhrases = [
      "Voice transcription will appear here in real time...",
      "Recording your voice... speak now, and click SEND ANSWER when finished.",
      "Transcribing speech with Gemini 1.5 Flash...",
      "No speech detected. Click mic to talk.",
      "Voice was not clear. Try again or click Switch to Type.",
      "Transcription error. Click mic to try again.",
      "Tap microphone or type to answer..."
    ];
    
    const hasLiveTranscript = liveText && !ignoredPhrases.includes(liveText) && liveText.length >= 5;
    
    if (hasLiveTranscript) {
      liveSubtitleBox.contentEditable = "true";
      liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-ink/90 overflow-y-auto text-left select-all focus:outline-none focus:border-accent-blue/40";
      
      liveSubtitleBox.oninput = () => {
        textareaAnswer.value = liveSubtitleBox.textContent;
      };
      
      micInstructions.textContent = "Review transcription above (click to edit), then click SEND ANSWER.";
      setOrbState('idle');
      return;
    }

    btnSubmitAnswer.disabled = true;
    btnSubmitAnswer.textContent = "TRANSCRIBING...";
    btnMicToggle.disabled = true;
    setOrbState('thinking');
    
    liveSubtitleBox.innerHTML = '<span class="text-accent-blue animate-pulse">Transcribing speech with Gemini 1.5 Flash...</span>';
    liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-ink/90 overflow-y-auto text-center flex items-center justify-center select-none";

    try {
      const audioBlob = await getRecordedAudioBlob();
      if (audioBlob && audioBlob.size > 2000) {
        const base64Audio = await blobToBase64(audioBlob);
        const geminiTranscript = await transcribeAudio(apiKey, base64Audio, 'audio/webm');
        if (geminiTranscript && geminiTranscript.trim().length > 2) {
          const finalAnswer = geminiTranscript.trim();
          textareaAnswer.value = finalAnswer;
          
          liveSubtitleBox.textContent = finalAnswer;
          liveSubtitleBox.contentEditable = "true";
          liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-ink/90 overflow-y-auto text-left select-all focus:outline-none focus:border-accent-blue/40";
          
          liveSubtitleBox.oninput = () => {
            textareaAnswer.value = liveSubtitleBox.textContent;
          };
          
          countFillerWords(finalAnswer);
          calculateWpm(finalAnswer);
          
          micInstructions.textContent = "Review transcription above (click to edit), then click SEND ANSWER.";
        } else {
          liveSubtitleBox.textContent = "Voice was not clear. Try again or click Switch to Type.";
          liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-mute/50 overflow-y-auto text-center italic flex items-center justify-center select-none";
          micInstructions.textContent = "Click microphone to record again";
        }
      } else {
        liveSubtitleBox.textContent = "No speech detected. Click mic to talk.";
        liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-mute/50 overflow-y-auto text-center italic flex items-center justify-center select-none";
        micInstructions.textContent = "Click microphone to record again";
      }
    } catch (err) {
      console.error("Transcription error:", err);
      liveSubtitleBox.textContent = "Transcription error. Click mic to try again.";
      liveSubtitleBox.className = "w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-red-400/70 overflow-y-auto text-center italic flex items-center justify-center select-none";
      micInstructions.textContent = "Click microphone to try again";
    } finally {
      btnSubmitAnswer.disabled = false;
      btnSubmitAnswer.textContent = "SEND ANSWER";
      btnMicToggle.disabled = false;
      setOrbState('idle');
    }
  }

  function stopRecording() {
    isMuted = true;
    
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      try {
        mediaRecorder.stop();
      } catch (err) {
        console.error("Failed to stop MediaRecorder:", err);
      }
    }

    if (recognition) {
      try {
        recognition.stop();
      } catch (e) {}
    }

    // Stop microphone stream tracks to turn off the hardware mic light
    if (currentStream) {
      try {
        currentStream.getTracks().forEach(track => track.stop());
      } catch (e) {}
      currentStream = null;
    }

    setOrbState('idle');
    btnMicToggle.className = "w-16 h-16 rounded-full bg-slate-900/60 border border-white/10 flex items-center justify-center cursor-pointer hover:scale-[1.05] active:scale-[0.95] transition-all group shadow-md";
    
    if (isVirtualMic) {
      liveSubtitleBox.contentEditable = "true";
      micInstructions.textContent = "Review transcription above (click to edit), or click mic to add more.";
    } else {
      micInstructions.textContent = "Microphone muted. Tap to talk";
    }
  }

  // Helper to fetch recorded blob with a Promise wrapper if active
  async function getRecordedAudioBlob() {
    if (!mediaRecorder) return null;
    
    if (mediaRecorder.state === 'recording') {
      try {
        mediaRecorder.stop();
      } catch (err) {
        console.error("Error stopping recorder in getRecordedAudioBlob:", err);
      }
    }
    
    if (currentRecordingPromise) {
      return currentRecordingPromise;
    }
    
    if (audioChunks.length > 0) {
      return new Blob(audioChunks, { type: 'audio/webm' });
    }
    return null;
  }

  // Convert Blob to Base64 helper
  function blobToBase64(blob) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onloadend = () => {
        const base64String = reader.result.split(',')[1];
        resolve(base64String);
      };
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  }

  let userSoundbarAnimationId = null;

  function animateUserSoundbar() {
    const soundbar = document.getElementById('user-glitch-soundbar');
    if (!soundbar) {
      userSoundbarAnimationId = requestAnimationFrame(animateUserSoundbar);
      return;
    }
    
    const bars = soundbar.children;
    if (bars.length === 0) {
      userSoundbarAnimationId = requestAnimationFrame(animateUserSoundbar);
      return;
    }

    const isUserActive = state === 'interview' && micEnabled && !isMuted && !isSpeakingBot;

    if (isUserActive) {
      soundbar.classList.remove('opacity-0');
      soundbar.classList.add('opacity-100');
      
      if (analyserNode && frequencyData) {
        analyserNode.getByteFrequencyData(frequencyData);
      }
      
      for (let i = 0; i < bars.length; i++) {
        const bar = bars[i];
        const multiplier = Math.sin(Math.PI * (i / (bars.length - 1)));
        
        let targetHeight = 4;
        if (frequencyData && !isVirtualMic) {
          const binIdx = Math.floor(i * (frequencyData.length / bars.length));
          const val = frequencyData[binIdx] || 0;
          targetHeight = 4 + (val / 255) * 72 * multiplier;
        } else if (isVirtualMic) {
          // Virtual Mic visualizer powered by keyboard typing energy
          const timeSinceLastKey = Date.now() - lastKeyPressTime;
          const keyEnergy = Math.max(0, 1 - timeSinceLastKey / 1200); // Decays over 1.2s
          
          const t = Date.now() * 0.008;
          const baseWave = (Math.sin(t + i * 0.2) * 0.5 + 0.5);
          const typingWave = Math.random() * keyEnergy * 60;
          
          targetHeight = 4 + (baseWave * 15 + typingWave) * multiplier;
        } else {
          // Procedural animation fallback
          const t = Date.now() * 0.008;
          targetHeight = 4 + (Math.sin(t + i * 0.2) * 0.5 + 0.5) * 60 * multiplier * (0.8 + Math.random() * 0.2);
        }
        
        bar.style.height = `${targetHeight}px`;
      }
    } else {
      soundbar.classList.remove('opacity-100');
      soundbar.classList.add('opacity-0');
      
      for (let i = 0; i < bars.length; i++) {
        const bar = bars[i];
        bar.style.height = '4px';
      }
    }

    userSoundbarAnimationId = requestAnimationFrame(animateUserSoundbar);
  }

  // --- SPEECH METRIC REAL-TIME ANALYZERS ---
  function countFillerWords(text) {
    const fillerWords = ["um", "uh", "basically", "so", "like", "you know"];
    const words = text.toLowerCase().replace(/[^a-zA-Z ]/g, "").split(/\s+/);
    let count = 0;
    
    words.forEach(word => {
      if (fillerWords.includes(word)) {
        count++;
      }
    });

    // Check for "you know" specifically
    const youKnowMatches = (text.toLowerCase().match(/you know/g) || []).length;
    count += youKnowMatches; // account for multi-word phrase matching

    currentFillersCount = count;
    counterFillersText.textContent = currentFillersCount;
  }

  function calculateWpm(text) {
    if (currentAnswerStartTime === 0) return;
    const elapsedMinutes = (Date.now() - currentAnswerStartTime) / 60000;
    if (elapsedMinutes < 0.05) return; // avoid huge divisions early on

    const wordCount = text.split(/\s+/).filter(w => w.length > 0).length;
    const wpm = Math.round(wordCount / elapsedMinutes);
    
    if (wpm > 0 && wpm < 300) {
      hudWpmText.textContent = `${wpm} WPM`;
    }
  }

  // --- ELEVENLABS AUDIO UTILITY ---
  async function speakViaElevenLabs(text, voiceType) {
    const voiceId = ELEVENLABS_VOICE_IDS[voiceType] || ELEVENLABS_VOICE_IDS.eleven_thomas;
    const url = `https://api.elevenlabs.io/v1/text-to-speech/${voiceId}`;
    
    const response = await fetch(url, {
      method: "POST",
      headers: {
        "xi-api-key": elevenApiKey,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        text: text,
        model_id: "eleven_flash_v2_5",
        voice_settings: {
          stability: 0.7,
          similarity_boost: 0.8,
          speed: 0.88 // slow to medium pace
        }
      })
    });

    if (!response.ok) {
      throw new Error(`ElevenLabs API returned status ${response.status}`);
    }

    const blob = await response.blob();
    const audioUrl = URL.createObjectURL(blob);
    sharedAudioPlayer.src = audioUrl;
    return sharedAudioPlayer;
  }

  // --- TYPEWRITER SYNCHRONIZATION HELPERS ---
  let wordRenderTimeouts = [];

  function startWordByWordRendering(words, fallbackText) {
    stopWordByWordRendering();
    
    const getTargetEl = () => isCodingMode ? codingHintToast : (document.getElementById('active-question-bubble') || questionText);
    const targetEl = getTargetEl();
    if (!targetEl) return;
    targetEl.innerHTML = '';
    
    if (isCodingMode && codingHintToast) {
      codingHintToast.classList.remove('opacity-0', 'translate-y-2');
      codingHintToast.classList.add('opacity-100', 'translate-y-0');
    }
    
    if (!words || words.length === 0) {
      const wordsCount = fallbackText.split(/\s+/).length;
      const estimatedDuration = (wordsCount * 60) / 140; // 140 WPM estimate
      startTypewriter(fallbackText, estimatedDuration);
      return;
    }
    
    words.forEach((word, index) => {
      const timeoutId = setTimeout(() => {
        const currentTarget = getTargetEl();
        if (!currentTarget) return;
        if (index === 0) {
          currentTarget.textContent = word.text;
        } else {
          currentTarget.textContent += " " + word.text;
        }
      }, word.start);
      wordRenderTimeouts.push(timeoutId);
    });
  }
 
  function stopWordByWordRendering() {
    wordRenderTimeouts.forEach(t => clearTimeout(t));
    wordRenderTimeouts = [];
  }
 
  function startTypewriter(text, durationSeconds) {
    stopTypewriter();
    
    const getTargetEl = () => isCodingMode ? codingHintToast : (document.getElementById('active-question-bubble') || questionText);
    const targetEl = getTargetEl();
    if (!targetEl) return;
    targetEl.innerHTML = '';
 
    if (isCodingMode && codingHintToast) {
      codingHintToast.classList.remove('opacity-0', 'translate-y-2');
      codingHintToast.classList.add('opacity-100', 'translate-y-0');
    }
    
    const words = text.split(/\s+/).filter(w => w.length > 0);
    const totalMs = durationSeconds * 1000;
    let wordDelay = totalMs / words.length;
    if (isNaN(wordDelay) || wordDelay <= 0) wordDelay = 250;
    wordDelay = Math.max(80, Math.min(500, wordDelay));
    
    let index = 0;
    typewriterInterval = setInterval(() => {
      const currentTarget = getTargetEl();
      if (!currentTarget) return;
      if (index < words.length) {
        if (index === 0) {
          currentTarget.textContent = words[index];
        } else {
          currentTarget.textContent += ' ' + words[index];
        }
        index++;
      } else {
        clearInterval(typewriterInterval);
        typewriterInterval = null;
      }
    }, wordDelay);
  }

  function stopTypewriter() {
    if (typewriterInterval) {
      clearInterval(typewriterInterval);
      typewriterInterval = null;
    }
  }

  // --- TEXT-TO-SPEECH PLAYBACK (TTS) ---
  function unlockAudioContextAndPlayer() {
    try {
      sharedAudioPlayer.src = "data:audio/wav;base64,UklGRigAAABXQVZFZm10IBIAAAABAAEARKwAAIhYAQACABAAAABkYXRhAgAAAAAA";
      sharedAudioPlayer.play().then(() => {
        sharedAudioPlayer.pause();
      }).catch(e => {
        console.warn("Silent unlock play caught:", e);
      });
    } catch(e) {
      console.warn("Silent unlock failed:", e);
    }
    if (audioContext && audioContext.state === 'suspended') {
      audioContext.resume().catch(e => console.warn("Failed to resume audioContext:", e));
    }
  }

  function speakQuestion(text) {
    if (window.speechSynthesis.speaking) {
      window.speechSynthesis.cancel();
    }
    if (activeAudioElement) {
      activeAudioElement.pause();
      activeAudioElement = null;
    }
    stopWordByWordRendering();
    stopTypewriter();

    let cleanText = text.replace(/Question \d+ of \d+:/gi, "").trim();
    if (isCodingMode && (cleanText.includes('#') || cleanText.includes('Given') || cleanText.includes('nums') || cleanText.includes('solve('))) {
      cleanText = "I have displayed the coding challenge on the left. Please review the problem description and write your solution in the editor on the right. You can ask me clarifying questions or request hints by using the microphone button at the bottom.";
    }
    const selectedVoiceVal = selectVoice.value;
    const isElevenVoice = selectedVoiceVal.startsWith('eleven_');
    const isEdgeVoice = selectedVoiceVal.startsWith('edge_');

    let fallbackTriggered = false;
    const triggerFallback = () => {
      if (fallbackTriggered) return;
      fallbackTriggered = true;
      isSpeakingBot = false;
      activeAudioElement = null;
      speakBrowserFallback(cleanText);
    };

    if (isEdgeVoice) {
      isSpeakingBot = true;
      if (recognition && !isMuted) {
        try { recognition.stop(); } catch(e) {}
      }
      setOrbState('speaking');

      let voiceName = 'en-US-AndrewMultilingualNeural';
      if (selectedVoiceVal === 'edge_brian') voiceName = 'en-US-BrianNeural';
      if (selectedVoiceVal === 'edge_emma') voiceName = 'en-US-EmmaNeural';

      fetch('http://127.0.0.1:5000/api/tts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: cleanText, voice: voiceName })
      })
      .then(res => {
        if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
        return res.json();
      })
      .then(data => {
        sharedAudioPlayer.src = data.audio;
        activeAudioElement = sharedAudioPlayer;
        
        sharedAudioPlayer.onplay = () => {
          isSpeakingBot = true;
          setOrbState('speaking');
          startWordByWordRendering(data.words, cleanText);
        };
        sharedAudioPlayer.onended = () => {
          isSpeakingBot = false;
          activeAudioElement = null;
          stopWordByWordRendering();
          stopTypewriter();
          if (isCodingMode && codingHintToast) {
            codingHintToast.innerHTML = `<strong>Interviewer:</strong> ${cleanText}`;
            setTimeout(() => {
              if (!isSpeakingBot) hideCodingHintToast();
            }, 6000);
          } else {
            const targetEl = isCodingMode ? codingHintToast : (document.getElementById('active-question-bubble') || questionText);
            if (targetEl) targetEl.textContent = cleanText;
          }
          onSpeechPlaybackEnd();
        };
        sharedAudioPlayer.onerror = (e) => {
          console.error("Edge audio element playback error:", e);
          triggerFallback();
        };
        
        sharedAudioPlayer.play().catch(err => {
          console.error("Failed to play Edge audio, falling back:", err);
          triggerFallback();
        });
      })
      .catch(err => {
        console.error("Failed to fetch Edge TTS data, falling back:", err);
        triggerFallback();
      });
    } else if (isElevenVoice && elevenApiKey) {
      isSpeakingBot = true;
      if (recognition && !isMuted) {
        try { recognition.stop(); } catch(e) {}
      }
      setOrbState('speaking');

      speakViaElevenLabs(cleanText, selectedVoiceVal)
        .then((audio) => {
          activeAudioElement = audio;
          audio.onplay = () => {
            isSpeakingBot = true;
            setOrbState('speaking');
            const duration = audio.duration && !isNaN(audio.duration) && audio.duration > 0
              ? audio.duration
              : (cleanText.split(' ').length * 60) / 140;
            startTypewriter(cleanText, duration);
          };
          audio.onended = () => {
            isSpeakingBot = false;
            activeAudioElement = null;
            stopTypewriter();
            if (isCodingMode && codingHintToast) {
              codingHintToast.innerHTML = `<strong>Interviewer:</strong> ${cleanText}`;
              setTimeout(() => {
                if (!isSpeakingBot) hideCodingHintToast();
              }, 6000);
            } else {
              const targetEl = isCodingMode ? codingHintToast : (document.getElementById('active-question-bubble') || questionText);
              if (targetEl) targetEl.textContent = cleanText;
            }
            onSpeechPlaybackEnd();
          };
          audio.onerror = (e) => {
            console.error("Audio playback error:", e);
            triggerFallback();
          };
          audio.play().catch(err => {
            console.error("Failed to autoplay audio:", err);
            triggerFallback();
          });
        })
        .catch((err) => {
          console.warn("ElevenLabs TTS failed, falling back to browser synthesis:", err);
          triggerFallback();
        });
    } else {
      if (isElevenVoice && !elevenApiKey) {
        console.warn("ElevenLabs key missing, falling back to browser synthesis.");
      }
      triggerFallback();
    }
  }

  function speakBrowserFallback(cleanText) {
    const utterance = new SpeechSynthesisUtterance(cleanText);
    activeUtterance = utterance;
    const voices = window.speechSynthesis.getVoices();
    let selectedVoice = null;
    
    if (selectVoice.value && !selectVoice.value.startsWith('eleven_') && !selectVoice.value.startsWith('edge_')) {
      selectedVoice = voices.find(v => v.name === selectVoice.value);
    }

    const femaleVoiceKeywords = [
      'female', 'zira', 'hazel', 'susan', 'heera', 'haruka', 'jessica', 'karen', 
      'moira', 'tessa', 'veena', 'samantha', 'victoria', 'kyoko', 'yuri', 'mei-jia',
      'sin-ji', 'fiona', 'zoe', 'stephanie', 'anna', 'helena', 'zosia', 'laura'
    ];

    if (!selectedVoice) {
      selectedVoice = voices.find(v => {
        const name = v.name.toLowerCase();
        const lang = v.lang.toLowerCase();
        const isEnglish = lang.includes('en');
        const isExplicitlyMale = name.includes('male') || name.includes('david') || name.includes('daniel') || name.includes('google us english') || name.includes('andrew') || name.includes('brian') || name.includes('thomas') || name.includes('antoni') || name.includes('adam');
        return isEnglish && isExplicitlyMale;
      });
    }

    if (!selectedVoice) {
      selectedVoice = voices.find(v => {
        const name = v.name.toLowerCase();
        const lang = v.lang.toLowerCase();
        const isEnglish = lang.includes('en');
        const isFemale = femaleVoiceKeywords.some(keyword => name.includes(keyword));
        return isEnglish && !isFemale;
      });
    }

    if (!selectedVoice) {
      selectedVoice = voices.find(v => v.lang.toLowerCase().includes('en'));
    }

    if (selectedVoice) {
      utterance.voice = selectedVoice;
    }

    utterance.rate = 1.0;
    utterance.pitch = 1.0;

    utterance.onstart = () => {
      isSpeakingBot = true;
      if (!isMuted) {
        if (recognition) {
          try { recognition.stop(); } catch(e) {}
        }
        if (mediaRecorder && mediaRecorder.state === 'recording') {
          try { mediaRecorder.pause(); } catch(e) {}
        }
      }
      setOrbState('speaking');
      renderChatHistory(); // Ensure the active question bubble has content = "" and id="active-question-bubble"
      
      const duration = (cleanText.split(' ').length * 60) / 140;
      startTypewriter(cleanText, duration);
      
      (window as any).speechStartTime = Date.now();
      (window as any).speechEstimatedDuration = duration * 1000;
    };

    utterance.onend = () => {
      isSpeakingBot = false;
      (window as any).speechStartTime = null;
      (window as any).speechEstimatedDuration = null;
      if (isCodingMode && codingHintToast) {
        codingHintToast.innerHTML = `<strong>Interviewer:</strong> ${cleanText}`;
        setTimeout(() => {
          if (!isSpeakingBot) hideCodingHintToast();
        }, 6000);
      } else {
        const targetEl = isCodingMode ? codingHintToast : (document.getElementById('active-question-bubble') || questionText);
        if (targetEl) targetEl.textContent = cleanText;
      }
      onSpeechPlaybackEnd();
    };

    utterance.onerror = () => {
      isSpeakingBot = false;
      (window as any).speechStartTime = null;
      (window as any).speechEstimatedDuration = null;
      setOrbState('idle');
      const targetEl = isCodingMode ? codingHintToast : (document.getElementById('active-question-bubble') || questionText);
      if (targetEl) targetEl.textContent = cleanText;
    };

    window.speechSynthesis.speak(utterance);
  }

  function onSpeechPlaybackEnd() {
    if (!isTypingMode && micEnabled) {
      if (mediaRecorder && mediaRecorder.state === 'paused') {
        try { mediaRecorder.resume(); } catch(e) {}
        if (recognition) {
          try {
            accumulatedTranscript = textareaAnswer.value.trim();
            if (accumulatedTranscript) accumulatedTranscript += ' ';
            recognition.start();
          } catch(e) {}
        }
      } else {
        startRecording();
      }
    } else {
      setOrbState('idle');
    }
  }

  // --- STATE SWITCHERS ---
  function switchView(viewName) {
    Object.keys(views).forEach(key => {
      if (views[key]) {
        views[key].classList.remove('morphing-to-ball', 'unfold-from-ball');
        if (key === viewName) {
          views[key].classList.remove('hidden');
        } else {
          views[key].classList.add('hidden');
        }
      }
    });

    state = viewName;
  }

  function switchViewWithOrb(fromKey, toKey, callback, isSlow = false) {
    const fromView = views[fromKey];
    const toView = views[toKey];
    if (!fromView || !toView) {
      switchView(toKey);
      if (callback) callback();
      return;
    }

    const collapseDuration = isSlow ? 1.2 : 0.45;
    const expandDuration = isSlow ? 1.5 : 0.55;
    const opacityDuration = isSlow ? 0.9 : 0.3;
    const fadeDuration = isSlow ? 0.9 : 0.3;
    const fadeDelay = isSlow ? 0.8 : 0.25;

    const root = document.documentElement;
    root.style.setProperty('--transition-collapse-duration', `${collapseDuration}s`);
    root.style.setProperty('--transition-opacity-duration', `${opacityDuration}s`);
    root.style.setProperty('--transition-expand-duration', `${expandDuration}s`);
    root.style.setProperty('--transition-fade-duration', `${fadeDuration}s`);
    root.style.setProperty('--transition-fade-delay', `${fadeDelay}s`);

    // 1. Collapse the current view into a ball
    fromView.classList.add('morphing-to-ball');
    
    // 2. Wait for collapse animation
    setTimeout(() => {
      fromView.classList.remove('morphing-to-ball');
      fromView.classList.add('hidden');
      
      toView.classList.remove('hidden');
      toView.classList.add('unfold-from-ball');
      state = toKey;
      
      if (callback) callback();

      // Remove unfold class after expansion completes
      setTimeout(() => {
        toView.classList.remove('unfold-from-ball');
      }, expandDuration * 1000);
    }, collapseDuration * 1000);
  }

