---
import Layout from "../layouts/Layout.astro";
import InterviewerOrb from "../components/InterviewerOrb.astro";
import DashboardAnalytics from "../components/DashboardAnalytics.astro";

const publicGeminiApiKey = import.meta.env.PUBLIC_GEMINI_API_KEY || "";
const publicElevenApiKey = import.meta.env.PUBLIC_ELEVENLABS_API_KEY || "";
---

<Layout title="Vevario — Real-time AI Mock Interviewer">
  <!-- Hidden environment config container -->
  <div id="env-config" data-gemini={publicGeminiApiKey} data-eleven={publicElevenApiKey} class="hidden"></div>

  <!-- Top Navigation Header (Frosted Glass Sticky Navigation) -->
  <header class="border-b border-hairline bg-surface-card/60 backdrop-blur-md sticky top-0 z-50 shadow-[0_4px_20px_rgba(0,0,0,0.15)] transition-all">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <div id="nav-logo" class="flex items-center gap-3 cursor-pointer select-none">
        <!-- Vercel-like Triangle Logo (Soft glowing shadow) -->
        <svg class="w-5 h-5 text-ink filter drop-shadow-[0_0_5px_rgba(255,255,255,0.3)]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L2 22h20L12 2z" />
        </svg>
        <span class="font-mono text-sm font-semibold tracking-[0.25em] text-ink font-display">VEVARIO</span>
        <span class="px-2.5 py-0.5 rounded bg-white/5 border border-hairline text-[10px] font-mono text-ink font-medium shadow-[inset_1px_1px_2px_rgba(255,255,255,0.05)]">BETA</span>
      </div>

      <!-- Status Badge & Theme Toggle -->
      <div class="flex items-center gap-3">
        <!-- Connection Status LED -->
        <div id="api-status-badge" class="flex items-center gap-2 font-mono text-[10px] px-3 py-1 bg-surface-elevated/40 border border-hairline rounded-full shadow-[inset_1px_1px_2px_rgba(255,255,255,0.05),0_2px_4px_rgba(0,0,0,0.05)]">
          <span id="api-status-dot" class="w-1.5 h-1.5 rounded-full bg-accent-red shadow-[0_0_6px_#ef4444]"></span>
          <span id="api-status-text" class="text-mute font-medium">KEY MISSING</span>
        </div>

        <!-- Premium Theme Toggle Button -->
        <button id="theme-toggle" class="p-2 bg-surface-elevated/40 border border-hairline rounded-full hover:bg-white/[0.08] hover:border-white/20 transition-all cursor-pointer shadow-[inset_1px_1px_2px_rgba(255,255,255,0.05),0_2px_4px_rgba(0,0,0,0.05)] flex items-center justify-center text-ink" aria-label="Toggle Theme">
          <!-- Moon Icon (shows when light theme active, to switch to dark) -->
          <svg id="theme-icon-dark" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
          <!-- Sun Icon (shows when dark theme active, to switch to light) -->
          <svg id="theme-icon-light" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m0 13.5V21M4.22 4.22l1.59 1.59m12.38 12.38l1.59 1.59M3 12h2.25m13.5 0H21M5.81 18.19l-1.59 1.59m12.38-12.38l-1.59 1.59M12 7.5a4.5 4.5 0 110 9 4.5 4.5 0 010-9z" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow flex items-center justify-center relative bg-transparent overflow-hidden min-h-[calc(100vh-4rem)]">

    <!-- ===================================== -->
    <!-- 0. LANDING / HERO VIEW                -->
    <!-- ===================================== -->
    <div id="landing-view" class="max-w-4xl w-full px-6 py-12 z-10 flex flex-col justify-center items-center gap-10 animate-[fadeIn_0.5s_ease-out] mx-auto">
      <div class="text-center space-y-4 max-w-2xl">
        <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest text-link uppercase bg-link/10 border border-link/25 px-3.5 py-1 rounded-full shadow-sm">
          <span>00 / INTRODUCTION</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-display font-light tracking-tight text-ink leading-tight">
          Master Your Next Tech Interview with Real-Time AI
        </h1>
        <p class="text-sm md:text-base text-mute leading-relaxed max-w-xl mx-auto">
          Experience conversational mock interviews tailored to your resume. Get real-time audio dialogues, focus on customized topics, and receive instant performance tips.
        </p>
      </div>

      <!-- Action Button -->
      <div>
        <button id="btn-get-started" class="premium-btn premium-btn-primary px-8 py-3.5 text-xs font-mono font-semibold tracking-widest uppercase shadow-lg select-none active:scale-[0.97] transition-all cursor-pointer">
          GET STARTED
        </button>
      </div>

      <!-- Features Grid (3 columns) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full mt-6">
        <!-- Feature 1 -->
        <div class="glass-panel p-6 flex flex-col gap-3 relative overflow-hidden group hover:translate-y-[-2px] transition-all">
          <div class="absolute -right-8 -top-8 w-16 h-16 radial-glow-blue opacity-10 rounded-full filter blur-xl pointer-events-none group-hover:opacity-20 transition-opacity"></div>
          <div class="w-8 h-8 rounded-lg bg-link/10 border border-link/20 flex items-center justify-center text-link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
            </svg>
          </div>
          <h3 class="text-sm font-mono font-semibold text-ink">Real-time Dialogue</h3>
          <p class="text-xs text-mute leading-relaxed">
            Talk naturally without latency. Our responsive voice engine listens, understands, and replies instantly.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="glass-panel p-6 flex flex-col gap-3 relative overflow-hidden group hover:translate-y-[-2px] transition-all">
          <div class="absolute -right-8 -top-8 w-16 h-16 radial-glow-blue opacity-10 rounded-full filter blur-xl pointer-events-none group-hover:opacity-20 transition-opacity"></div>
          <div class="w-8 h-8 rounded-lg bg-link/10 border border-link/20 flex items-center justify-center text-link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.43l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.991l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.645-.869l.214-1.28z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-sm font-mono font-semibold text-ink">Custom Sessions</h3>
          <p class="text-xs text-mute leading-relaxed">
            Target specific interview domains. Tailor focus areas, difficulty levels, and practice lengths.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="glass-panel p-6 flex flex-col gap-3 relative overflow-hidden group hover:translate-y-[-2px] transition-all">
          <div class="absolute -right-8 -top-8 w-16 h-16 radial-glow-blue opacity-10 rounded-full filter blur-xl pointer-events-none group-hover:opacity-20 transition-opacity"></div>
          <div class="w-8 h-8 rounded-lg bg-link/10 border border-link/20 flex items-center justify-center text-link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21l-1.81-5.096L2.1 14.1 7.19 12.28 9 7.19l1.81 5.09L15.9 14.1l-5.09 1.804zm-3.21-6.195L6 12l-.594-2.291L3.11 9.11l2.291-.594L6 6.023l.594 2.291 2.292.594-2.292.594zm10.796 3.195l-.297 1.146L15 15l1.146-.297.297-1.146.297 1.146 1.146.297-1.146.297-.297 1.146z" />
            </svg>
          </div>
          <h3 class="text-sm font-mono font-semibold text-ink">Actionable Feedback</h3>
          <p class="text-xs text-mute leading-relaxed">
            Get instant hints mid-interview when you get stuck, followed by a comprehensive performance scorecard.
          </p>
        </div>
      </div>
    </div>

    <!-- ===================================== -->
    <!-- 1. SETUP STATE VIEW                   -->
    <!-- ===================================== -->
    <div id="setup-view" class="hidden max-w-2xl w-full px-6 py-12 z-10 flex flex-col justify-center items-stretch animate-[fadeIn_0.5s_ease-out]">
      <!-- Center Title -->
      <div class="text-center mb-8">
        <div class="text-[10px] font-mono tracking-widest text-mute uppercase mb-2">01 / Initialization</div>
        <h2 class="text-4xl font-display font-light tracking-tight text-ink">
          Configure Interview Session
        </h2>
      </div>

      <!-- Config Panel (Frosted Glass Panel with 3D Tilt capability) -->
      <div class="glass-panel p-8 relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-32 h-32 radial-glow-blue opacity-25 rounded-full filter blur-2xl z-0 pointer-events-none"></div>

        <!-- Form Fields -->
        <div class="space-y-6 relative z-10">

          <!-- Resume Upload -->
          <div>
            <label class="block text-[10px] font-mono text-mute uppercase mb-1.5">
              Resume (PDF or Text Paste)
            </label>
            <div id="pdf-drop-zone" class="glass-upload-zone glass-inset p-6 text-center cursor-pointer relative">
              <input type="file" id="input-resume-file" accept="application/pdf" class="hidden" />
              <div class="space-y-2">
                <svg class="w-6 h-6 mx-auto text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                  <polyline points="10 9 9 9 8 9" />
                </svg>
                <div class="text-xs text-ink" id="pdf-status">Drag & drop your Resume PDF, or click to upload</div>
                <div class="text-[10px] text-mute font-mono">Max size 4MB</div>
              </div>
            </div>
            <!-- Alternative Text Area -->
            <button id="toggle-paste-btn" class="mt-2 text-[10px] font-mono text-link hover:underline cursor-pointer bg-transparent border-0">
              Or paste resume text instead
            </button>
            <textarea id="input-resume-text" placeholder="Paste resume contents here..." 
              class="hidden glass-input glass-inset w-full h-32 mt-2 p-3 text-xs font-mono text-ink placeholder-mute/50 focus:outline-none transition-all resize-none"></textarea>
          </div>

          <!-- Topic Checklist -->
          <div>
            <label class="block text-[10px] font-mono text-mute uppercase mb-2">
              Select Focus Topics <span class="text-accent-red">*</span>
            </label>
            <div id="topic-tags" class="flex flex-wrap gap-2.5">
              {["Coding (DSA)", "System Design", "Databases", "OOPs Concepts", "Behavioral (STAR)", "Web Development", "Operating Systems"].map((topic) => (
                <button type="button" data-topic={topic} class="topic-tag shadow-sm">
                  {topic}
                </button>
              ))}
            </div>
          </div>

          <!-- Select Box: Voice & Difficulty & Count Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Difficulty -->
            <div>
              <label class="block text-[10px] font-mono text-mute uppercase mb-1.5">
                Difficulty
              </label>
              <select id="select-difficulty" class="glass-input glass-inset w-full px-3 py-2 text-xs font-mono text-ink focus:outline-none transition-all cursor-pointer">
                <option value="Junior (Easy)" class="bg-[#0f172a]">Junior</option>
                <option value="Mid-Level (Medium)" selected class="bg-[#0f172a]">Mid-Level</option>
                <option value="Senior (Hard)" class="bg-[#0f172a]">Senior</option>
                <option value="Lead/Staff (Expert)" class="bg-[#0f172a]">Lead / Staff</option>
              </select>
            </div>

            <!-- Question count -->
            <div>
              <label class="block text-[10px] font-mono text-mute uppercase mb-1.5">
                Question Count
              </label>
              <select id="select-count" class="glass-input glass-inset w-full px-3 py-2 text-xs font-mono text-ink focus:outline-none transition-all cursor-pointer">
                <option value="10" class="bg-[#0f172a]">10 Questions</option>
                <option value="15" class="bg-[#0f172a]">15 Questions</option>
                <option value="25" class="bg-[#0f172a]">25 Questions</option>
                <option value="5" selected class="bg-[#0f172a]">5 Questions (Quick)</option>
              </select>
            </div>

            <!-- Hidden select-voice element to maintain JS compatibility -->
            <select id="select-voice" class="hidden">
              <option value="edge_andrew" selected>edge_andrew</option>
            </select>
          </div>

          <!-- Premium CTA button for "INITIALIZE SESSION" -->
          <button id="btn-start" class="premium-btn premium-btn-primary w-full py-3 mt-4 font-semibold text-xs font-mono tracking-wider rounded-full active:scale-[0.97] transition-all cursor-pointer shadow-md disabled:opacity-50 disabled:cursor-not-allowed">
            INITIALIZE SESSION
          </button>
        </div>
      </div>
    </div>

    <!-- ===================================== -->
    <!-- 2. INTERVIEW SIMULATOR HUD VIEW       -->
    <!-- ===================================== -->
    <!-- (Frosted glass container with 3D Tilt support) -->
    <div id="interview-view" class="hidden max-w-6xl w-full px-6 py-8 flex flex-col gap-6 items-stretch z-10 animate-[fadeIn_0.5s_ease-out] mx-auto">
      
      <!-- Standard Interview Workspace (Side-by-Side Split Grid) -->
      <div id="standard-workspace" class="grid grid-cols-1 md:grid-cols-12 gap-16 items-stretch w-full min-h-[580px]">
        
        <!-- Left Column: Floating AI Agent UI (takes 5 cols) -->
        <div class="md:col-span-5 flex flex-col items-center justify-center p-6 relative">
          <!-- Orb Visualizer Component -->
          <InterviewerOrb />

          <!-- Mic controls placed directly here -->
          <div class="flex flex-col items-center gap-4 mt-6 z-10">
            <!-- Speaking/listening action mic button (Glowy circular outline) -->
            <button id="btn-mic-toggle" class="w-16 h-16 rounded-full flex items-center justify-center cursor-pointer transition-all hover:scale-[1.05] active:scale-[0.95] premium-btn shadow-md">
              <!-- Mic Icon -->
              <svg class="w-6 h-6 text-ink transition-all duration-300" id="mic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                <line x1="12" y1="19" x2="12" y2="23" />
                <line x1="8" y1="23" x2="16" y2="23" />
              </svg>
            </button>
            <div class="text-[10px] font-mono text-mute uppercase tracking-widest text-center" id="mic-instructions">
              Click to unmute microphone
            </div>
          </div>

          <!-- Soundwave visualizer placed at the bottom -->
          <div id="user-glitch-soundbar" class="flex gap-1 justify-center items-center h-20 w-full max-w-xs mt-6 opacity-0 transition-opacity duration-300 z-10">
            <!-- Filled dynamically by JavaScript on mount -->
          </div>
        </div>

        <!-- Right Column: Dialogue Chatbox (takes 7 cols) -->
        <div class="md:col-span-7 flex flex-col justify-between glass-panel p-6 relative h-[580px] max-h-[580px] min-h-[580px]">
          <div class="absolute -right-12 -top-12 w-24 h-24 radial-glow-blue opacity-25 rounded-full filter blur-xl pointer-events-none z-0"></div>
          
          <!-- Chat Panel Header with HUD stats -->
          <div class="w-full flex items-center justify-between font-mono text-[10px] text-mute mb-4 border-b border-white/10 pb-3 relative z-10">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-green animate-pulse"></span>
              <span>INTERVIEW IN PROGRESS</span>
            </div>
            <div class="flex items-center gap-4">
              <span id="question-progress-label" class="text-mute uppercase">Question 1 of 5</span>
              <span>•</span>
              <span id="session-timer" class="text-ink">00:00</span>
            </div>
          </div>

          <!-- Real-time metrics HUD (Glass status pills) -->
          <div class="flex gap-2 mb-4 relative z-10">
            <!-- Um Counter -->
            <div class="flex items-center gap-1.5 px-3 py-1 bg-white/[0.03] border border-white/10 rounded-full text-[10px] font-mono shadow-sm">
              <span class="text-accent-red font-semibold">UM/UH:</span>
              <span id="counter-fillers" class="text-ink font-bold">0</span>
            </div>
            <!-- WPM Gauge -->
            <div class="flex items-center gap-1.5 px-3 py-1 bg-white/[0.03] border border-white/10 rounded-full text-[10px] font-mono shadow-sm">
              <span class="text-accent-green font-semibold">SPEED:</span>
              <span id="hud-wpm" class="text-ink font-bold">0 WPM</span>
            </div>
          </div>

          <!-- Chat History Scrolling Container -->
          <div id="chat-history-container" class="overflow-y-auto pr-1 mb-4 space-y-4 h-[310px] min-h-[310px] max-h-[310px] relative z-10 scroll-smooth">
            <!-- Dynamic chat bubbles loaded here -->
          </div>

          <!-- Hidden legacy components for JS compatibility -->
          <div id="question-text" class="hidden"></div>

          <!-- Input Area (Main Box) -->
          <div class="relative z-10 w-full">
            <!-- Voice Recognition Subtitles Mode (Default) -->
            <div id="voice-input-container" class="w-full">
              <!-- Live scrolling subtitle transcript (Recessed Glass container) -->
              <div id="live-subtitle-box" class="w-full glass-inset bg-black/45 border border-white/5 rounded-xl p-4 h-24 text-sm font-light leading-relaxed text-mute/50 overflow-y-auto text-center italic flex items-center justify-center select-none">
                Voice transcription will appear here in real time...
              </div>
            </div>
   
            <!-- Text Input Mode -->
            <div id="text-input-container" class="hidden w-full">
              <textarea id="textarea-answer" placeholder="Draft your answer conceptually..." 
                class="w-full glass-inset bg-[#0c0f1d]/70 border border-white/10 rounded-xl p-4 text-sm font-light text-ink placeholder-mute/50 focus:outline-none focus:border-accent-blue/30 transition-all resize-none h-24"></textarea>
            </div>
          </div>

          <!-- Footer Control Area -->
          <div class="border-t border-white/10 pt-4 mt-4 flex items-center justify-between gap-4 relative z-10">
            <div class="flex items-center gap-2.5">
              <!-- Glass Switch to Type button -->
              <button id="btn-toggle-input-mode" class="px-3.5 py-1.5 premium-btn font-mono text-[10px] uppercase tracking-wider flex items-center gap-1.5 cursor-pointer">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="M6 8h10M6 12h8M6 16h4" />
                </svg>
                <span>Switch to Type</span>
              </button>
  
              <!-- Glass Get Hint button -->
              <button id="btn-hint" class="px-3.5 py-1.5 premium-btn font-mono text-[10px] uppercase tracking-wider flex items-center gap-1.5 cursor-pointer">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="16" x2="12" y2="12" />
                  <line x1="12" y1="8" x2="12.01" y2="8" />
                </svg>
                <span>Get Hint</span>
              </button>
            </div>
   
            <!-- Answer submission buttons -->
            <div class="flex items-center gap-2">
              <!-- Quit Button -->
              <button id="btn-end-early" class="premium-btn border-accent-red/20 text-accent-red hover:bg-accent-red/10 px-4 py-2 rounded-full font-mono text-[10px] tracking-wider uppercase cursor-pointer transition-all">
                Quit
              </button>
              <!-- Premium primary CTA button -->
              <button id="btn-submit-answer" class="px-6 py-2.5 premium-btn premium-btn-primary font-semibold rounded-full font-mono text-[10px] tracking-wider uppercase cursor-pointer transition-all shadow-md">
                SEND ANSWER
              </button>
            </div>
          </div>
  
          <!-- Hint Dialog (Frosted Glass Dialog overlay) -->
          <div id="hint-display" class="hidden absolute top-4 left-4 right-4 bg-slate-900/90 backdrop-blur-md border border-accent-green/30 shadow-[0_10px_30px_rgba(0,0,0,0.5)] rounded-lg p-3 text-xs text-accent-green font-mono flex items-start gap-2.5 z-20">
            <svg class="w-4 h-4 flex-shrink-0 text-accent-green mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
            <div class="flex-grow">
              <span class="font-bold">Interviewer Tip:</span>
              <span id="hint-text">Try explaining indexing latency.</span>
            </div>
            <button id="btn-close-hint" class="text-mute hover:text-ink cursor-pointer">&times;</button>
          </div>
        </div>
      </div>

      <!-- Coding (DSA) Workspace (LeetCode Style Redesign) -->
